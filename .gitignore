# EasyCV 项目 Git 忽略配置

# ===========================================
# 构建和打包产物
# ===========================================

# 构建输出目录
dist/

# 发布包目录
releases/

# 构建信息文件
build-info.json

# ===========================================
# Node.js 相关
# ===========================================

# 依赖包目录
node_modules/

# npm 锁定文件（保留 package-lock.json 用于确保依赖版本一致性）
# package-lock.json  # 注释掉，建议保留

# npm 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# ===========================================
# 临时文件和缓存
# ===========================================

# 临时目录
.tmp/
.tmp-quick-*/
.tmp-deploy-*/
temp/
tmp/

# 缓存目录
.cache/
.npm/
.yarn/

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===========================================
# 编辑器和IDE
# ===========================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm/IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ===========================================
# 日志文件
# ===========================================

# 应用日志
logs/
*.log

# 错误日志
error.log
access.log

# ===========================================
# 环境配置
# ===========================================

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ===========================================
# 测试相关
# ===========================================

# 测试覆盖率报告
coverage/
.nyc_output/

# Jest 缓存
.jest/

# ===========================================
# 压缩和归档文件
# ===========================================

# 压缩文件（除了发布包）
*.zip
*.tar.gz
*.rar
*.7z

# 但保留 releases 目录下的发布包（已在上面排除整个目录）

# ===========================================
# 浏览器扩展开发相关
# ===========================================

# Chrome 扩展打包文件
*.crx
*.pem

# 扩展商店资源
store-assets/
screenshots/
promo-images/

# 真实站点测试持久化 profile（含真实登录态 cookie，严禁入库）
test/real-sites/.profile/

# ===========================================
# 备份文件
# ===========================================

# 备份文件
*.bak
*.backup
*.old
*.orig

# ===========================================
# 其他
# ===========================================

# 系统文件
*.tmp
*.temp

# 编译输出
*.o
*.so
*.dylib
*.dll

# 文档生成
/docs/generated/

# 本地配置文件
local.config.js
local.config.json

# 调试文件
debug.log
*.debug

# 性能分析文件
*.prof

# ===========================================
# 项目特定排除
# ===========================================

# 开发时的临时文件
dev-temp/

# 自动生成的文档
auto-docs/

# Playwright CLI 缓存
.playwright-cli/

# AI 工具本地目录（含 worktree 注册，误 add 会产生 gitlink）
.claude/
