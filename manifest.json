{
  "manifest_version": 3,
  "name": "EasyCV - 解除网页复制粘贴限制",
  "version": "1.0.0",
  "description": "一键解除网页复制粘贴限制，提升工作效率的浏览器插件",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/dom-utils.js",
        "utils/message-utils.js",
        "utils/storage-utils.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EasyCV - 解除网页复制粘贴限制",
    "default_icon": {
      "16": "icons/icon-default-16.png",
      "32": "icons/icon-default-32.png",
      "48": "icons/icon-default-48.png",
      "128": "icons/icon-default-128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-default-16.png",
    "32": "icons/icon-default-32.png",
    "48": "icons/icon-default-48.png",
    "128": "icons/icon-default-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/injector.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}